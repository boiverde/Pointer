{
    "version": 2,
    "builds": [
        {
            "src": "src/serverless.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/serverless.ts",
            "methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "OPTIONS"
            ]
        }
    ],
    "env": {
        "NODE_OPTIONS": "--no-warnings"
    }
}